<?xml version="1.0" ?>
<!--
  lab.world  -  a 10 m x 8 m indoor environment standing in for your college
  floor: outer walls, internal partitions and furniture. Good enough to build
  a real occupancy grid with gmapping and to test AMCL localisation.

  Replace this with a floor plan of your actual building later; nothing else
  in the stack needs to change.
-->
<sdf version="1.6">
  <world name="lab">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <shadows>false</shadows>
    </scene>

    <gui>
      <camera name="user_camera">
        <pose>0 -12 10 0 0.65 1.5707963</pose>
      </camera>
    </gui>

    <model name="wall_north">
      <static>true</static>
      <pose>0.0 4.0 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.0 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.0 0.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0.0 -4.0 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.0 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.0 0.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5.0 0.0 0.5 0 0 1.5707963</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.0 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.0 0.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5.0 0.0 0.5 0 0 1.5707963</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.0 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.0 0.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="part_1">
      <static>true</static>
      <pose>-1.5 1.8 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="part_2">
      <static>true</static>
      <pose>1.5 -1.0 0.5 0 0 1.5707963</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="part_3">
      <static>true</static>
      <pose>-3.0 -1.5 0.5 0 0 1.5707963</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.0 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.15 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="table_1">
      <static>true</static>
      <pose>3.0 2.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.8 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.8 0.75</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="table_2">
      <static>true</static>
      <pose>-3.5 3.0 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.6 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.6 0.75</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="crate_1">
      <static>true</static>
      <pose>0.5 -2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="crate_2">
      <static>true</static>
      <pose>-1.0 -0.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="pillar_1">
      <static>true</static>
      <pose>2.0 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 2.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
