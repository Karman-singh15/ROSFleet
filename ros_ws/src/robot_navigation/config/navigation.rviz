# RViz layout for navigation. Open with:
#   rviz -d $(rospack find robot_navigation)/config/navigation.rviz
# Displays chosen so you can diagnose the three things that actually go
# wrong: bad localisation (ParticleCloud spread), a bad costmap (inflation
# swallowing doorways), and a bad plan (global vs local path disagreeing).
Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 620
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic: /map
    - Alpha: 1
      Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      Visual Enabled: true
    - Class: rviz/TF
      Enabled: false
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Alpha: 1
      Class: rviz/LaserScan
      Color: 255; 60; 60
      Color Transformer: FlatColor
      Enabled: true
      Name: LaserScan
      Size (Pixels): 3
      Style: Points
      Topic: /scan
      Use Fixed Frame: true
    - Alpha: 1
      Arrow Length: 0.12
      Class: rviz/PoseArray
      Color: 0; 192; 255
      Enabled: true
      Name: AMCL ParticleCloud
      Topic: /particlecloud
    - Alpha: 0.5
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Global Costmap
      Topic: /move_base/global_costmap/costmap
    - Alpha: 0.6
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Local Costmap
      Topic: /move_base/local_costmap/costmap
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 25; 255; 0
      Enabled: true
      Line Width: 0.03
      Name: Global Plan
      Topic: /move_base/DWAPlannerROS/global_plan
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 170; 0
      Enabled: true
      Line Width: 0.03
      Name: Local Plan
      Topic: /move_base/DWAPlannerROS/local_plan
    - Alpha: 1
      Class: rviz/Pose
      Color: 255; 25; 255
      Enabled: true
      Head Length: 0.08
      Head Radius: 0.05
      Name: Current Goal
      Shaft Length: 0.2
      Shaft Radius: 0.02
      Topic: /move_base/current_goal
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    # Drag this on the map to tell AMCL where the robot really is.
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    # Drag this to send the robot somewhere - the manual version of what
    # the website's "Deploy Mission" button does.
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: Current View
      Scale: 60
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1400
