<?xml version="1.0"?>
<!--
  navigation.launch  -  autonomous navigation on a KNOWN map.

      roslaunch robot_navigation navigation.launch                  (sim)
      roslaunch robot_navigation navigation.launch sim:=false       (real robot)
      roslaunch robot_navigation navigation.launch map:=/path/floor1.yaml

  Assumes something is already publishing /scan, /odom and TF - either
  robot_gazebo/simulation.launch or robot_hardware/hardware.launch.

  WHAT EACH PIECE DOES
    map_server : loads the .pgm/.yaml and publishes /map
    amcl       : matches /scan against /map, publishes the map->odom
                 correction that cancels odometry drift
    move_base  : plans a path, follows it, avoids obstacles, emits /cmd_vel
-->
<launch>
  <arg name="map"  default="$(find robot_navigation)/maps/lab.yaml"/>
  <arg name="sim"  default="true"/>
  <arg name="rviz" default="true"/>

  <!-- Initial guess of where the robot is. In sim this matches the spawn
       pose in simulation.launch; on the real robot you set it in RViz or
       from the website. -->
  <arg name="initial_pose_x" default="-3.5"/>
  <arg name="initial_pose_y" default="-2.5"/>
  <arg name="initial_pose_a" default="0.0"/>

  <param name="/use_sim_time" value="$(arg sim)"/>

  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map)">
    <param name="frame_id" value="map"/>
  </node>

  <node name="amcl" pkg="amcl" type="amcl" output="screen">
    <rosparam command="load" file="$(find robot_navigation)/config/amcl_params.yaml"/>
    <param name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <param name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <param name="initial_pose_a" value="$(arg initial_pose_a)"/>
  </node>

  <node name="move_base" pkg="move_base" type="move_base" output="screen"
        respawn="false">
    <rosparam command="load"
              file="$(find robot_navigation)/config/move_base_params.yaml"/>
    <rosparam command="load"
              file="$(find robot_navigation)/config/dwa_local_planner.yaml"/>
    <!-- costmap_common is loaded into BOTH costmaps' namespaces, which is
         why the same footprint and laser settings apply to each. -->
    <rosparam command="load" ns="global_costmap"
              file="$(find robot_navigation)/config/costmap_common.yaml"/>
    <rosparam command="load" ns="local_costmap"
              file="$(find robot_navigation)/config/costmap_common.yaml"/>
    <rosparam command="load"
              file="$(find robot_navigation)/config/costmap_global.yaml"/>
    <rosparam command="load"
              file="$(find robot_navigation)/config/costmap_local.yaml"/>
  </node>

  <group if="$(arg rviz)">
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find robot_navigation)/config/navigation.rviz"/>
  </group>
</launch>
