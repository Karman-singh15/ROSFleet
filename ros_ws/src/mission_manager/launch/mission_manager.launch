<?xml version="1.0"?>
<!--
  mission_manager.launch

      roslaunch mission_manager mission_manager.launch
      roslaunch mission_manager mission_manager.launch require_hardware:=false

  Needs move_base already running (robot_navigation/navigation.launch).
-->
<launch>
  <!-- In simulation there is no ESP32, and fake_telemetry latches
       /hardware_connected true, so this can stay on in both modes. -->
  <arg name="require_hardware" default="true"/>
  <arg name="goal_timeout"     default="300.0"/>

  <node name="mission_manager" pkg="mission_manager"
        type="mission_manager_node.py" output="screen" respawn="true">
    <param name="map_frame"         value="map"/>
    <param name="base_frame"        value="base_footprint"/>
    <param name="require_hardware"  value="$(arg require_hardware)"/>
    <param name="goal_timeout"      value="$(arg goal_timeout)"/>
    <param name="arrival_tolerance" value="0.15"/>
  </node>
</launch>
