<?xml version="1.0"?>
<!--
  sim.launch - THE WHOLE SYSTEM, simulated. One command:

      roslaunch robot_bringup sim.launch

  Starts: Gazebo + robot + map + AMCL + move_base + mission manager + RViz.
  After this you can send the robot somewhere three ways:
    1. the "2D Nav Goal" button in RViz
    2. rosservice call /start_mission ...
    3. the website (once the backend is running)

  This is the launch file you will spend most of your development time in.
-->
<launch>
  <arg name="gui"  default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="map"  default="$(find robot_navigation)/maps/lab.yaml"/>

  <!-- Spawn pose; also AMCL's initial guess, so they must agree or the
       robot starts out believing it is somewhere it is not. -->
  <arg name="x"   default="-3.5"/>
  <arg name="y"   default="-2.5"/>
  <arg name="yaw" default="0.0"/>

  <include file="$(find robot_gazebo)/launch/simulation.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="x"   value="$(arg x)"/>
    <arg name="y"   value="$(arg y)"/>
    <arg name="yaw" value="$(arg yaw)"/>
  </include>

  <include file="$(find robot_navigation)/launch/navigation.launch">
    <arg name="map"            value="$(arg map)"/>
    <arg name="sim"            value="true"/>
    <arg name="rviz"           value="$(arg rviz)"/>
    <arg name="initial_pose_x" value="$(arg x)"/>
    <arg name="initial_pose_y" value="$(arg y)"/>
    <arg name="initial_pose_a" value="$(arg yaw)"/>
  </include>

  <include file="$(find mission_manager)/launch/mission_manager.launch">
    <arg name="require_hardware" value="true"/>
  </include>

  <!-- WebSocket bridge the backend connects to. Same in sim and on the
       real robot, which is why the backend needs no "am I simulated?" flag. -->
  <include file="$(find robot_bringup)/launch/rosbridge.launch"/>
</launch>
