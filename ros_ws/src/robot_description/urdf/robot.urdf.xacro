<?xml version="1.0"?>
<!--
  robot.urdf.xacro  -  the ROSFleet robot
  =======================================
  FRAME TREE produced by this file (+ robot_state_publisher):

      map            (map_server / AMCL)
       └── odom      (odometry source: Gazebo or hardware bridge)
            └── base_footprint      <- point on the ground under the robot
                 └── base_link      <- chassis centre, everything hangs off this
                      ├── left_wheel_link
                      ├── right_wheel_link
                      ├── caster_link
                      └── laser_link  <- LiDAR optical origin, /scan frame
-->
<robot name="rosfleet_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_gazebo" default="true"/>

  <xacro:include filename="$(find robot_description)/urdf/common_properties.xacro"/>

  <!-- ================================================================
       base_footprint : the projection of the robot onto the floor.
       The navigation stack and AMCL localise THIS frame, not base_link.
       ================================================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <!-- Lift the chassis so its underside sits at base_clearance -->
    <origin xyz="0 0 ${base_clearance + base_height/2.0}" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       base_link : the chassis
       ================================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="chassis_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <!-- ================================================================
       Drive wheels
       reflect =  1  -> left   (+Y)
       reflect = -1  -> right  (-Y)
       ================================================================ -->
  <xacro:macro name="drive_wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_x_offset} ${reflect * wheel_separation / 2.0}
                   ${-(base_height/2.0 + base_clearance - wheel_radius)}"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.02" friction="0.005"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  reflect="1"/>
  <xacro:drive_wheel prefix="right" reflect="-1"/>

  <!-- ================================================================
       Caster : a low-friction sphere that keeps the robot level.
       On the real chassis this is the metal ball caster.
       ================================================================ -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="caster_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_link"/>
    <origin xyz="${caster_x_offset} 0
                 ${-(base_height/2.0 + base_clearance - caster_radius)}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_link">
    <!-- Near-zero friction so the caster slides instead of fighting the drive wheels -->
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ================================================================
       LiDAR
       The frame is called laser_link and it is what /scan is stamped with.
       ================================================================ -->
  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="lidar_red"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_link"/>
    <origin xyz="0 0 ${base_height/2.0 + lidar_z_offset}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ================================================================
       Simulation-only plugins (differential drive + laser).
       When running on the REAL robot this file is loaded with
       use_gazebo:=false so no plugin is included - the hardware bridge
       publishes /odom and the real LiDAR driver publishes /scan instead.
       ================================================================ -->
  <xacro:if value="$(arg use_gazebo)">
    <xacro:include filename="$(find robot_description)/urdf/robot.gazebo.xacro"/>
  </xacro:if>

</robot>
