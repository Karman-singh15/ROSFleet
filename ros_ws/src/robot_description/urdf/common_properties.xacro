<?xml version="1.0"?>
<!--
  common_properties.xacro
  ======================
  Every physical number about the robot lives HERE and nowhere else.
  When you build the real chassis, measure it and change these values.
  Everything downstream (Gazebo, TF, odometry, navigation footprint,
  and the ESP32 firmware constants) is derived from them.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ CHASSIS ============ -->
  <xacro:property name="base_length" value="0.200"/>   <!-- X, metres -->
  <xacro:property name="base_width"  value="0.150"/>   <!-- Y, metres -->
  <xacro:property name="base_height" value="0.050"/>   <!-- Z, metres -->
  <xacro:property name="base_mass"   value="1.200"/>   <!-- kg, incl. battery -->

  <!-- Height of the chassis underside above the ground -->
  <xacro:property name="base_clearance" value="0.020"/>

  <!-- ============ DRIVE WHEELS ============ -->
  <!-- Standard yellow TT/BO motor wheel is 65 mm diameter -->
  <xacro:property name="wheel_radius"    value="0.0325"/>
  <xacro:property name="wheel_width"     value="0.026"/>
  <xacro:property name="wheel_mass"      value="0.050"/>
  <!-- Distance between the CONTACT POINTS of the two drive wheels.
       This is the single most important number for differential-drive
       odometry. Measure it on the real robot with a ruler. -->
  <xacro:property name="wheel_separation" value="0.160"/>
  <!-- Where the wheel axle sits along X relative to base_link centre -->
  <xacro:property name="wheel_x_offset"  value="0.040"/>

  <!-- ============ CASTER ============ -->
  <xacro:property name="caster_radius" value="0.0160"/>
  <xacro:property name="caster_mass"   value="0.020"/>
  <xacro:property name="caster_x_offset" value="-0.070"/>

  <!-- ============ LIDAR ============ -->
  <xacro:property name="lidar_radius" value="0.0375"/>
  <xacro:property name="lidar_height" value="0.040"/>
  <xacro:property name="lidar_mass"   value="0.170"/>
  <xacro:property name="lidar_z_offset" value="0.045"/>  <!-- above chassis top -->

  <!-- ============ MOTION LIMITS ============ -->
  <!-- Used by the local planner and by the ESP32 firmware clamp. -->
  <xacro:property name="max_linear_velocity"  value="0.35"/>  <!-- m/s  -->
  <xacro:property name="max_angular_velocity" value="1.50"/>  <!-- rad/s -->

  <!-- ============ MATERIALS ============ -->
  <material name="chassis_blue"><color rgba="0.15 0.35 0.75 1.0"/></material>
  <material name="wheel_black"> <color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="caster_grey"> <color rgba="0.60 0.60 0.60 1.0"/></material>
  <material name="lidar_red">   <color rgba="0.80 0.15 0.15 1.0"/></material>

  <!-- ============ INERTIA MACROS ============ -->
  <!-- Gazebo refuses to simulate links with zero/absurd inertia, so we
       compute proper inertia tensors for the primitive shapes we use. -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3.0*r*r+h*h)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(3.0*r*r+h*h)/12.0}" iyz="0.0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2.0*m*r*r/5.0}" ixy="0.0" ixz="0.0"
               iyy="${2.0*m*r*r/5.0}" iyz="0.0"
               izz="${2.0*m*r*r/5.0}"/>
    </inertial>
  </xacro:macro>

</robot>
